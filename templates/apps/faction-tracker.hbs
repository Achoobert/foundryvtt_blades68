<div class="blades68-sheet-root">
<header class="tracker-header">
  <h1>{{localize "BLADES68.FactionTracker.Title"}}</h1>
  <button type="button" data-action="fortuneRoll">{{localize "BLADES68.FactionTracker.FortuneRoll"}}</button>
</header>

<div class="tracker-grid">
  {{#each columns as |column|}}
    <div class="tracker-column">
      <h2>{{localize (concat "BLADES68.FactionCategory." column.category)}}</h2>
      <ul class="faction-list">
        {{#each column.factions as |faction|}}
          <li class="faction-row {{#if faction.system.war}}at-war{{/if}}">
            <span class="faction-name">{{faction.name}}</span>
            {{> "systems/blades68/templates/partials/dot-track.hbs"
                value=faction.system.tier max=6 action="setTier" itemId=faction.id }}
            <a class="hold-toggle" data-action="cycleHold" data-item-id="{{faction.id}}">
              {{localize (concat "BLADES68.HoldState." faction.system.hold)}}
            </a>
            <span class="status-control">
              <a data-action="adjustStatus" data-item-id="{{faction.id}}" data-delta="-1">-</a>
              <span class="status-value">{{faction.system.status}}</span>
              <a data-action="adjustStatus" data-item-id="{{faction.id}}" data-delta="1">+</a>
            </span>
            <a class="war-toggle {{#if faction.system.war}}active{{/if}}" data-action="toggleWar" data-item-id="{{faction.id}}">
              {{localize "BLADES68.AtWar"}}
            </a>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/each}}
</div>
</div>
