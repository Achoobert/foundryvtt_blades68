<div class="blades68-sheet-root">
<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" />
  <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" /></h1>
</header>

<section class="sheet-body">
  <label>{{localize "BLADES68.Category"}}
    <select name="system.category">
      {{#each config.FACTION_CATEGORIES as |category|}}
        <option value="{{category}}" {{#ifEquals category ../system.category}}selected{{/ifEquals}}>{{localize (concat "BLADES68.FactionCategory." category)}}</option>
      {{/each}}
    </select>
  </label>
  <div class="track-row">
    <label>{{localize "BLADES68.Tier"}}</label>
    {{> "systems/blades68/templates/partials/dot-track.hbs" value=system.tier max=6 path="system.tier" }}
  </div>
  <label>{{localize "BLADES68.Hold"}}
    <select name="system.hold">
      {{#each config.HOLD as |hold|}}
        <option value="{{hold}}" {{#ifEquals hold ../system.hold}}selected{{/ifEquals}}>{{localize (concat "BLADES68.HoldState." hold)}}</option>
      {{/each}}
    </select>
  </label>
  <label>{{localize "BLADES68.Status"}} <input type="number" name="system.status" value="{{system.status}}" min="-3" max="3" /></label>
  <label class="war-flag">
    <input type="checkbox" name="system.war" {{checked system.war}} /> {{localize "BLADES68.AtWar"}}
  </label>

  <fieldset class="faction-description">
    <legend>{{localize "BLADES68.Description"}}</legend>
    {{editor system.description target="system.description" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.PrestigeAbility"}}</legend>
    <input type="text" name="system.prestigeAbility.name" value="{{system.prestigeAbility.name}}" placeholder="{{localize 'BLADES68.PrestigeAbility'}}" />
    {{editor system.prestigeAbility.description target="system.prestigeAbility.description" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.Turf"}}</legend>
    {{editor system.turf target="system.turf" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.NPCs"}}</legend>
    {{editor system.npcs target="system.npcs" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.NotableAssets"}}</legend>
    {{editor system.notableAssets target="system.notableAssets" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.Quirks"}}</legend>
    {{editor system.quirks target="system.quirks" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.Allies"}}</legend>
    {{editor system.allies target="system.allies" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.Enemies"}}</legend>
    {{editor system.enemies target="system.enemies" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-dossier">
    <legend>{{localize "BLADES68.Situation"}}</legend>
    {{editor system.situation target="system.situation" button=true engine="prosemirror" collaborate=false}}
  </fieldset>

  <fieldset class="faction-clocks">
    <legend>{{localize "BLADES68.Tabs.Clocks"}}</legend>
    <div class="clock-grid">
      {{#each clocks as |clock|}}
        <div class="clock-entry">
          {{> "systems/blades68/templates/partials/clock-svg.hbs"
              value=clock.system.value max=clock.system.max color=clock.system.color
              label=clock.name action="setClockValue" itemId=clock.id }}
          <label class="clock-shared-toggle">
            <input type="checkbox" data-action="toggleClockShared" data-item-id="{{clock.id}}" {{checked clock.system.shared}} />
            {{localize "BLADES68.Shared"}}
          </label>
          <a data-action="deleteClock" data-item-id="{{clock.id}}">{{localize "BLADES68.Delete"}}</a>
        </div>
      {{/each}}
    </div>
    <button type="button" data-action="addClock">{{localize "BLADES68.AddClock"}}</button>
  </fieldset>

  <fieldset>
    <legend>{{localize "BLADES68.Notes"}}</legend>
    {{editor system.notes target="system.notes" button=true engine="prosemirror" collaborate=false}}
  </fieldset>
</section>
</div>
